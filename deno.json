{
  "name": "@wazoo/sparql-engine",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@/": "./src/",
    "@comunica/query-sparql-rdfjs-lite": "npm:@comunica/query-sparql-rdfjs-lite@^5.1.3",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "n3": "npm:n3@2.2.0",
    "oxigraph": "npm:oxigraph@^0.5.9"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "bench": "deno bench --allow-all",
    "check": "deno check",
    "ci": {
      "description": "Formats, lints, checks, and tests the code",
      "dependencies": [
        "fmt:check",
        "lint",
        "check",
        "test"
      ]
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "test": "deno test --allow-all",
    "test:w3c": "deno run --allow-all test/w3c/w3c-main.ts"
  },
  "fmt": {
    "exclude": [
      "vendor/sparql-parser/parser.cjs",
      "vendor/sparql-parser/Wildcard.js"
    ]
  },
  "lint": {
    "exclude": [
      "vendor/sparql-parser/parser.cjs",
      "vendor/sparql-parser/Wildcard.js"
    ]
  }
}
