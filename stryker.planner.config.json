{
  "_comment": "Report-only mutation run over src/planner/ against that folder's own tests. See stryker.config.json for why tsconfigFile names a missing file.",
  "tsconfigFile": "tsconfig.stryker-skip.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test src/planner/ --timeout 120000"
  },
  "mutate": [
    "src/planner/**/*.ts",
    "!src/planner/**/*.test.ts",
    "!src/planner/**/*test-helpers.ts",
    "!src/planner/**/*.native.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/planner.html" },
  "jsonReporter": { "fileName": "reports/mutation/planner.json" },
  "thresholds": { "break": null }
}
