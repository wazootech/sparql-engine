{
  "name": "@wazoo/sparql-engine",
  "description": "Zero-dependency SPARQL 1.1 & 1.2 query and update engine over RDF/JS Quad Stores.",
  "version": "0.5.4",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./term": "./src/term/public.ts",
    "./data-model": "./src/term/public.ts",
    "./store": "./src/store/memory-store.ts",
    "./parser": "./src/parser/mod.ts",
    "./serialize": "./src/serialize/mod.ts"
  },
  "publish": {
    "include": ["src/", "README.md", "LICENSE"],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.jison",
      "src/parser/generate-parser.ts"
    ]
  },
  "imports": {
    "@/": "./src/",
    "@comunica/query-sparql-rdfjs-lite": "npm:@comunica/query-sparql-rdfjs-lite@^5.1.3",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "ebnf-parser": "npm:ebnf-parser@0.1.10",
    "jison": "npm:jison@0.4.18",
    "n3": "npm:n3@2.2.0",
    "n3-rdfstar": "npm:n3@1.26.0",
    "oxigraph": "npm:oxigraph@^0.5.9",
    "@types/node": "npm:@types/node@^22.10.0"
  },
  "compilerOptions": { "strict": true }
}
