{
  "name": "@wazoo/sparql-engine",
  "private": true,
  "type": "module",
  "description": "Bun toolchain manifest for @wazoo/sparql-engine. The published package is described by jsr.json; scripts/check-manifests.ts keeps the two in sync.",
  "packageManager": "bun@1.4.5",
  "exports": {
    ".": "./src/mod.ts",
    "./term": "./src/term/public.ts",
    "./data-model": "./src/term/public.ts",
    "./store": "./src/store/memory-store.ts",
    "./parser": "./src/parser/mod.ts",
    "./serialize": "./src/serialize/mod.ts"
  },
  "scripts": {
    "bundle": "bun build --minify playground/bundle-entry.ts --outfile playground/app.js",
    "bench": "bun bench/engine_bench.ts && bun bench/cli-targets-bench.ts",
    "bench:check": "bun bench/budget.ts",
    "bench:size": "bun bench/measure-libs.ts > bench/size-data.json && bun bench/treemap.ts",
    "bench:size:closures": "bun bench/measure-closures.ts && bun bench/treemap.ts",
    "bench:memory": "bun bench/collect-memory.ts && bun bench/treemap.ts",
    "bench:latency": "bun bench/engine_bench.ts --json > bench/latency-data.json && bun bench/latency-chart.ts",
    "bench:latency:check": "BENCH_INVENTORY=1 bun bench/engine_bench.ts --json | bun bench/latency-check.ts",
    "bench:profile": "bun bench/parse-profile.ts",
    "bench:cli": "bun bench/cli-bench.ts",
    "bench:cli:targets": "bun bench/cli-targets-bench.ts",
    "check": "bun check --no-script",
    "check:manifests": "bun scripts/check-manifests.ts",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run check:manifests && bun run parser:check && bun run test && bun run publish:check && bun run bench:check && bun run test:exists-ref && bun run test:sparql12:gap && bun run test:sparql12 && bun run test:rdf11 && bun run test:rdf12",
    "compile": "bun build --compile --outfile dist/sparql cli/main.ts",
    "docs:link-check": "bun docs/link-check.ts",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "oxlint --deny-warnings",
    "native:coverage": "bun cli/native-coverage.ts",
    "native:build": "bun cli/native-build.ts",
    "native:gate": "bun cli/native-gate.ts",
    "parser:generate": "bun src/parser/generate-parser.ts",
    "parser:check": "bun src/parser/generate-parser.ts --check",
    "publish:dry": "jsr publish --dry-run --allow-dirty",
    "publish:check": "bun test/publish-graph-check.ts",
    "test": "bun test --timeout 120000",
    "test:exists-ref": "bun test/w3c/exists-ref.ts",
    "test:heldout-fuzz": "bun bench/heldout-fuzz.ts",
    "test:rdf11": "bun test/w3c/rdf-differential.ts",
    "test:rdf12": "bun test/w3c/rdf-classify.ts",
    "test:ref": "bun test/w3c/ref-crosscheck.ts",
    "test:sparql12": "bun test/w3c/sparql12-main.ts",
    "test:sparql12:gap": "bun test/w3c/sparql12-gap.ts",
    "test:w3c": "bun test/w3c/w3c-main.ts"
  },
  "dependencies": {
    "@comunica/query-sparql-rdfjs-lite": "^5.1.3",
    "@rdfjs/types": "^2.0.1",
    "ebnf-parser": "0.1.10",
    "jison": "0.4.18",
    "n3": "2.2.0",
    "n3-rdfstar": "npm:n3@1.26.0",
    "oxigraph": "^0.5.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wazoo/sparql-engine-published": "npm:@jsr/wazoo__sparql-engine@0.4.1",
    "jsr": "0.14.3",
    "mitata": "1.0.34",
    "oxlint": "1.94.0"
  },
  "patchedDependencies": {
    "@comunica/actor-http-fetch@5.5.0": "patches/@comunica%2Factor-http-fetch@5.5.0.patch"
  }
}
