%{
  /*
    SPARQL parser in the Jison parser generator format.

    Derived from sparqljs@3.7.4 `lib/sparql.jison`, maintained by this
    project. Generated by `deno task parser:generate`: jison is used only as an
    LR table generator. The generator emits `parser.ts`, a fully typed module
    (the LR driver and lexer runtime live in `lr-runtime.ts`; the semantic
    actions in `sparql-context.ts`), so the runtime artifact is pure ESM with
    zero runtime dependencies.

    This prologue holds only the imports the generated module needs. Every
    action below is a call into `sparql-context.ts`, which owns the parse
    context (base IRI, prefixes, factory, options) and the AST construction.
  */
  import type {
    AnnotationPart,
    ArgListValue,
    DatasetEntry,
    EntityNode,
    Grouping,
    GraphOrDefaultValue,
    GraphReference,
    InlineDataValue,
    InsertDeleteParts,
    NamedNodeTerm,
    ObjectEntry,
    OperatorTail,
    ParsedTriple,
    PathVerbObjects,
    QuadBlock,
    QuadTerm,
    QueryFragment,
    ReifierPart,
    SparqlResult,
    VariableNode,
    WithValue,
  } from "./sparql-context.ts";
  import type {
    AggregateExpression,
    BgpPattern,
    Expression,
    FunctionCallExpression,
    GroupPattern,
    Ordering,
    Pattern,
    PropertyPath,
    Query,
    SelectQuery,
    Term,
    Triple,
    UpdateOperation,
    UpdateQuery,
    ValuePatternRow,
    ValuesPattern,
    VariableExpression,
  } from "./ast.ts";
  import {
    aggregate,
    alternativePath,
    annotatedObject,
    annotationBlock,
    appendAnnotation,
    appendObject,
    argList,
    askQuery,
    basicGraphPattern,
    binaryOperation,
    bindPattern,
    blank,
    booleanLiteral,
    boundOperation,
    clearOrDropOperation,
    constructQuery,
    constructWhereQuery,
    copyMoveOperation,
    createAnonymousObject,
    createList,
    createOperation,
    createOperationTree,
    datasetEntry,
    decimalLiteral,
    declarePrefix,
    deleteDataOperation,
    deleteInsertParts,
    deleteWhereOperation,
    describeQuery,
    doubleLiteral,
    emptyArgList,
    emptyValuesRows,
    existsOperation,
    expressionList,
    filterPattern,
    finishParse,
    optionalTriples,
    flattenTripleLists,
    functionCall,
    graphOrDefaultDefault,
    graphOrDefaultNamed,
    graphPattern,
    graphReferenceKeyword,
    graphReferenceNamed,
    groupGraphPattern,
    groupGraphPatternSub,
    groupingFrom,
    insertDataOperation,
    insertOnlyParts,
    integerLiteral,
    inversePath,
    iriFromToken,
    labelledBlank,
    languageLiteral,
    limitOffset,
    loadOperation,
    lowercase,
    membershipOperation,
    minusPattern,
    modifiedPath,
    modifyOperation,
    negatedLiteralTail,
    negatedPath,
    negatedPropertySet,
    nestedInlineData,
    nodeSubjectTriples,
    objectListToTriples,
    operation,
    operatorTail,
    optionalPattern,
    orderingFrom,
    pathNodeSubjectTriples,
    pathOf,
    pathPropertyListTriples,
    pathVerbObjectTriples,
    pathVerbObjects,
    patternWithTriples,
    plainNode,
    prefixedNameLocal,
    prefixedNameNamespace,
    propertyListTriples,
    quadsGraphBlock,
    quadsOf,
    queryFromParts,
    quotedSubjectTriples,
    quotedTriple,
    quotedTripleWithReifier,
    rdfNilTerm,
    rdfTypeTerm,
    reifierClause,
    selectBase,
    selectItemExpression,
    selectVariables,
    selectWildcard,
    sequencePath,
    servicePattern,
    setBase,
    signedDecimalLiteral,
    signedDoubleLiteral,
    signedIntegerLiteral,
    signedTail,
    solutionModifier,
    solutionModifierNoGroup,
    sparqlStarTerm,
    starOperation,
    subSelect,
    subSelectGroup,
    subjectTriples,
    tripleTerm,
    typedLiteral,
    typedLiteralOf,
    unaryOperation,
    unescapeString,
    unionOrGroup,
    updateRequest,
    valuesClause,
    valuesForVariable,
    valuesForVariables,
    variableOf,
    variableSelectQuery,
    whereClause,
    wildcardSelectQuery,
    withClause,
  } from "./sparql-context.ts";
%}

%lex

// [139]
IRIREF                "<"(?:[^<>\"\{\}\|\^`\\\u0000-\u0020])*">"
// [140]
PNAME_NS              {PN_PREFIX}?":"
// [141]
PNAME_LN              {PNAME_NS}{PN_LOCAL}
// [142]
BLANK_NODE_LABEL      "_:"(?:{PN_CHARS_U}|[0-9])(?:(?:{PN_CHARS}|".")*{PN_CHARS})?
// [108] (and [143]-[144])
VAR                   [\?\$]{VARNAME}
// [145]
LANGTAG               "@"[a-zA-Z]+(?:"-"[a-zA-Z0-9]+)*("--"("ltr"|"rtl"))?
// [146]
INTEGER               [0-9]+
// [147]
DECIMAL               [0-9]*"."[0-9]+
// [148]
DOUBLE                [0-9]+"."[0-9]*{EXPONENT}|"."([0-9])+{EXPONENT}|([0-9])+{EXPONENT}
// [149]
INTEGER_POSITIVE      "+"{INTEGER}
// [150]
DECIMAL_POSITIVE      "+"{DECIMAL}
// [151]
DOUBLE_POSITIVE       "+"{DOUBLE}
// [152]
INTEGER_NEGATIVE      "-"{INTEGER}
// [153]
DECIMAL_NEGATIVE      "-"{DECIMAL}
// [154]
DOUBLE_NEGATIVE       "-"{DOUBLE}
// [155]
EXPONENT              [eE][+-]?[0-9]+
// [156]
STRING_LITERAL1       "'"(?:(?:[^\u0027\u005C\u000A\u000D])|{ECHAR})*"'"
// [157]
STRING_LITERAL2       "\""(?:(?:[^\u0022\u005C\u000A\u000D])|{ECHAR})*'"'
// [158]
STRING_LITERAL_LONG1  "'''"(?:(?:"'"|"''")?(?:[^'\\]|{ECHAR}))*"'''"
// [159]
STRING_LITERAL_LONG2  "\"\"\""(?:(?:"\""|'""')?(?:[^\"\\]|{ECHAR}))*'"""'
// [160]
ECHAR                 "\\"[tbnrf\\\"']|"\\u"{HEX}{HEX}{HEX}{HEX}|"\\U"{HEX}{HEX}{HEX}{HEX}{HEX}{HEX}{HEX}{HEX}
// [161]
NIL                   "("{WS}*")"
// [162]
WS                    \u0020|\u0009|\u000D|\u000A
// [163]
ANON                  "["{WS}*"]"
// [164]
PN_CHARS_BASE         [A-Za-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u02FF\u0370-\u037D\u037F-\u1FFF\u200C-\u200D\u2070-\u218F\u2C00-\u2FEF\u3001-\uD7FF\uF900-\uFDCF\uFDF0-\uFFFD]|[\uD800-\uDB7F][\uDC00-\uDFFF]
// [165]
PN_CHARS_U            (?:{PN_CHARS_BASE}|"_")
// [166]
VARNAME               (?:{PN_CHARS_U}|[0-9])(?:{PN_CHARS_U}|[0-9]|\u00B7|[\u0300-\u036F\u203F-\u2040])*
// [167]
PN_CHARS              {PN_CHARS_U}|"-"|[0-9]|\u00B7|[\u0300-\u036F\u203F-\u2040]
// [168]
PN_PREFIX             {PN_CHARS_BASE}(?:(?:{PN_CHARS}|".")*{PN_CHARS})?
// [169]
PN_LOCAL              (?:{PN_CHARS_U}|":"|[0-9]|{PLX})(?:(?:{PN_CHARS}|"."|":"|{PLX})*(?:{PN_CHARS}|":"|{PLX}))?
// [170]
PLX                   {PERCENT}|{PN_LOCAL_ESC}
// [171]
PERCENT               "%"{HEX}{HEX}
// [172]
HEX                   [0-9A-Fa-f]
// [173]
PN_LOCAL_ESC          "\\"("_"|"~"|"."|"-"|"!"|"$"|"&"|"'"|"("|")"|"*"|"+"|","|";"|"="|"/"|"?"|"#"|"@"|"%")
COMMENT               "#"[^\n\r]*
SPACES_COMMENTS       (\s+|{COMMENT}\n\r?)+

%options flex case-insensitive

%%

\s+|{COMMENT}            /* ignore */
"BASE"                   return 'BASE'
"PREFIX"                 return 'PREFIX'
"SELECT"                 return 'SELECT'
"DISTINCT"               return 'DISTINCT'
"REDUCED"                return 'REDUCED'
"("                      return '('
"AS"                     return 'AS'
")"                      return ')'
"*"                      return '*'
"CONSTRUCT"              return 'CONSTRUCT'
"WHERE"                  return 'WHERE'
"{"                      return '{'
"}"                      return '}'
"DESCRIBE"               return 'DESCRIBE'
"ASK"                    return 'ASK'
"FROM"                   return 'FROM'
"NAMED"                  return 'NAMED'
"GROUP"                  return 'GROUP'
"BY"                     return 'BY'
"HAVING"                 return 'HAVING'
"ORDER"                  return 'ORDER'
"ASC"                    return 'ASC'
"DESC"                   return 'DESC'
"LIMIT"                  return 'LIMIT'
"OFFSET"                 return 'OFFSET'
"VALUES"                 return 'VALUES'
";"                      return ';'
"LOAD"                   return 'LOAD'
"SILENT"                 return 'SILENT'
"INTO"                   return 'INTO'
"CLEAR"                  return 'CLEAR'
"DROP"                   return 'DROP'
"CREATE"                 return 'CREATE'
"ADD"                    return 'ADD'
"TO"                     return 'TO'
"MOVE"                   return 'MOVE'
"COPY"                   return 'COPY'
"INSERT"{SPACES_COMMENTS}"DATA"  return 'INSERTDATA'
"DELETE"{SPACES_COMMENTS}"DATA"  return 'DELETEDATA'
"DELETE"{SPACES_COMMENTS}"WHERE" return 'DELETEWHERE'
"WITH"                   return 'WITH'
"DELETE"                 return 'DELETE'
"INSERT"                 return 'INSERT'
"USING"                  return 'USING'
"DEFAULT"                return 'DEFAULT'
"GRAPH"                  return 'GRAPH'
"ALL"                    return 'ALL'
"."                      return '.'
"OPTIONAL"               return 'OPTIONAL'
"SERVICE"                return 'SERVICE'
"BIND"                   return 'BIND'
"UNDEF"                  return 'UNDEF'
"MINUS"                  return 'MINUS'
"UNION"                  return 'UNION'
"FILTER"                 return 'FILTER'
"<<("                    return '<<('
")>>"                    return ')>>'
"<<"                     return '<<'
">>"                     return '>>'
"~"                      return '~'
"{|"                     return '{|'
"|}"                     return '|}'
","                      return ','
"a"                      return 'a'
"|"                      return '|'
"/"                      return '/'
"^"                      return '^'
"?"                      return '?'
"+"                      return '+'
"!"                      return '!'
"["                      return '['
"]"                      return ']'
"||"                     return '||'
"&&"                     return '&&'
"="                      return '='
"!="                     return '!='
"<"                      return '<'
">"                      return '>'
"<="                     return '<='
">="                     return '>='
"IN"                     return 'IN'
"NOT"                    return 'NOT'
"-"                      return '-'
"BOUND"                  return 'BOUND'
"BNODE"                  return 'BNODE'
("RAND"|"NOW"|"UUID"|"STRUUID") return 'FUNC_ARITY0'
("LANGDIR"|"LANG"|"DATATYPE"|"IRI"|"URI"|"ABS"|"CEIL"|"FLOOR"|"ROUND"|"STRLEN"|"STR"|"UCASE"|"LCASE"|"ENCODE_FOR_URI"|"YEAR"|"MONTH"|"DAY"|"HOURS"|"MINUTES"|"SECONDS"|"TIMEZONE"|"TZ"|"MD5"|"SHA1"|"SHA256"|"SHA384"|"SHA512"|"isIRI"|"isURI"|"isBLANK"|"isLITERAL"|"isNUMERIC"|"hasLangDir") return 'FUNC_ARITY1'
"hasLang"                return 'HASLANG'
("SUBJECT"|"PREDICATE"|"OBJECT"|"isTRIPLE") return 'FUNC_ARITY1_SPARQL_STAR'
("LANGMATCHES"|"CONTAINS"|"STRSTARTS"|"STRENDS"|"STRBEFORE"|"STRAFTER"|"STRLANG"|"STRDT"|"sameTerm") return 'FUNC_ARITY2'
"CONCAT"                 return 'CONCAT'
"COALESCE"               return 'COALESCE'
"IF"|"STRLANGDIR"        return 'FUNC_ARITY3'
"TRIPLE"                 return 'FUNC_ARITY3_SPARQL_STAR'
"REGEX"                  return 'REGEX'
"SUBSTR"                 return 'SUBSTR'
"REPLACE"                return 'REPLACE'
"EXISTS"                 return 'EXISTS'
"COUNT"                  return 'COUNT'
"SUM"|"MIN"|"MAX"|"AVG"|"SAMPLE" return 'FUNC_AGGREGATE'
"GROUP_CONCAT"           return 'GROUP_CONCAT'
"SEPARATOR"              return 'SEPARATOR'
"^^"                     return '^^'
"true"|"false"           return 'BOOLEAN'
{IRIREF}                 return 'IRIREF'
{PNAME_NS}               return 'PNAME_NS'
{PNAME_LN}               return 'PNAME_LN'
{BLANK_NODE_LABEL}       return 'BLANK_NODE_LABEL'
{VAR}                    return 'VAR'
{LANGTAG}                return 'LANGTAG'
{INTEGER}                return 'INTEGER'
{DECIMAL}                return 'DECIMAL'
{DOUBLE}                 return 'DOUBLE'
{INTEGER_POSITIVE}       return 'INTEGER_POSITIVE'
{DECIMAL_POSITIVE}       return 'DECIMAL_POSITIVE'
{DOUBLE_POSITIVE}        return 'DOUBLE_POSITIVE'
{INTEGER_NEGATIVE}       return 'INTEGER_NEGATIVE'
{DECIMAL_NEGATIVE}       return 'DECIMAL_NEGATIVE'
{DOUBLE_NEGATIVE}        return 'DOUBLE_NEGATIVE'
{EXPONENT}               return 'EXPONENT'
{STRING_LITERAL1}        return 'STRING_LITERAL1'
{STRING_LITERAL2}        return 'STRING_LITERAL2'
{STRING_LITERAL_LONG1}   return 'STRING_LITERAL_LONG1'
{STRING_LITERAL_LONG2}   return 'STRING_LITERAL_LONG2'
{NIL}                    return 'NIL'
{ANON}                   return 'ANON'
<<EOF>>                  return 'EOF'
.                        return 'INVALID'

/lex

%ebnf

%start QueryOrUpdate

%%

QueryOrUpdate
    : Prologue ( Query /* [1] QueryUnit */ | Update? | Path ) EOF -> finishParse($2)
    ;

// [2]
Query
    : Qry ValuesClause? -> queryFromParts($1, $2)
    ;

// [4]
Prologue
    : ( BaseDecl | PrefixDecl )*
    ;

// [5]
BaseDecl
    : 'BASE' IRIREF
    {
      setBase($2);
    }
    ;

// [6]
PrefixDecl
    : 'PREFIX' PNAME_NS IRIREF
    {
      declarePrefix($2, $3);
    }
    ;

Qry
    // [7] SelectQuery: Didn't check use of SolutionModifierNoGroup seems off as this introduces a havinClause where not expected.
    : SelectClauseWildcard DatasetClause* WhereClause SolutionModifierNoGroup -> wildcardSelectQuery($1, $2, $3, $4)
    | SelectClauseVars     DatasetClause* WhereClause SolutionModifier -> variableSelectQuery($1, $2, $3, $4)
    // [10] ConstructQuery
    | 'CONSTRUCT' ConstructTemplate DatasetClause* WhereClause SolutionModifier -> constructQuery($2, $3, $4, $5)
    | 'CONSTRUCT' DatasetClause* 'WHERE' '{' TriplesTemplate? '}' SolutionModifier -> constructWhereQuery($2, $5, $7)
    // [11] DescribeQuery
    | 'DESCRIBE' ( VarOrIri+ | '*' ) DatasetClause* WhereClause? SolutionModifier -> describeQuery($2, $3, $4, $5)
    // [12] AskQuery
    | 'ASK' DatasetClause* WhereClause SolutionModifier -> askQuery($2, $3, $4)
    ;

SelectClauseWildcard
    : SelectClauseBase '*' -> selectWildcard($1)
    ;
SelectClauseVars
    : SelectClauseBase SelectClauseItem+ -> selectVariables($1, $2)
    ;
SelectClauseBase
    : 'SELECT' ( 'DISTINCT' | 'REDUCED' )? -> selectBase($2)
    ;
SelectClauseItem
    : Var
    | '(' Expression 'AS' Var ')' -> selectItemExpression($2, $4)
    ;

// [8]
SubSelect
    : SelectClauseWildcard WhereClause SolutionModifierNoGroup ValuesClause? -> subSelect($1, $2, $3, $4)
    | SelectClauseVars     WhereClause SolutionModifier        ValuesClause? -> subSelect($1, $2, $3, $4)
    ;

// [13]
DatasetClause
    // [14] & [15]
    : 'FROM' 'NAMED'? iri -> datasetEntry($2, $3)
    ;

// [17]
WhereClause
    : 'WHERE'? GroupGraphPattern -> whereClause($2)
    ;

// [18]
SolutionModifier
    : GroupClause? SolutionModifierNoGroup -> solutionModifier($1, $2)
    ;

SolutionModifierNoGroup
    : HavingClause? OrderClause? LimitOffsetClauses? -> solutionModifierNoGroup($1, $2, $3)
    ;

// [19]
GroupClause
    : 'GROUP' 'BY' GroupCondition+ -> { group: $3 }
    ;

// [20]
GroupCondition
    : BuiltInCall -> groupingFrom($1)
    | FunctionCall -> groupingFrom($1)
    | '(' Expression ')' -> groupingFrom($2)
    | '(' Expression 'AS' Var ')' -> groupingFrom($2, $4)
    | Var -> groupingFrom($1)
    ;

// [21]
HavingClause
    : 'HAVING' (Constraint /* [22] HavingCondition */)+ -> { having: $2 }
    ;

// [23]
OrderClause
    : 'ORDER' 'BY' OrderCondition+ -> { order: $3 }
    ;

// [24]
OrderCondition
    : 'ASC'  BrackettedExpression -> orderingFrom($2, false)
    | 'DESC' BrackettedExpression -> orderingFrom($2, true)
    | Constraint -> orderingFrom($1, false)
    | Var -> orderingFrom($1, false)
    ;

// [25]
LimitOffsetClauses
    // [26] LimitClause
    : 'LIMIT' INTEGER -> limitOffset($2, undefined)
    // [27] OffsetClause
    | 'OFFSET' INTEGER -> limitOffset(undefined, $2)
    | 'LIMIT'  INTEGER 'OFFSET' INTEGER -> limitOffset($2, $4)
    | 'OFFSET' INTEGER 'LIMIT'  INTEGER -> limitOffset($4, $2)
    ;

// [28]
ValuesClause
    : 'VALUES' InlineData -> valuesClause($2)
    ;

InlineData
    : VAR '{' DataBlockValue* '}' -> valuesForVariable($1, $3)
    | NIL '{' NIL* '}' -> emptyValuesRows($3)
    | '(' VAR+ ')' '{' DataBlockValueList* '}' -> valuesForVariables($2, $5)
    ;

DataBlockValueList
    : '(' DataBlockValue+ ')' -> $2
    ;

// [29]
Update
    : (Update1 ';' Prologue)* Update1 (';' Prologue)? -> updateRequest($1, $2)
    ;

// [30]
Update1
    // [31] Load
    : 'LOAD' 'SILENT'? iri IntoGraphClause? -> loadOperation($2, $3, $4)
    // [32]-[33] ClearOrDrop
    | ( 'CLEAR' | 'DROP' ) 'SILENT'? GraphRefAll -> clearOrDropOperation($1, $2, $3)
    // [35]-[37] AddOrMoveOrCopy
    | ( 'ADD' | 'MOVE' | 'COPY' ) 'SILENT'? GraphOrDefault 'TO' GraphOrDefault -> copyMoveOperation($1, $2, $3, $5)
    // [34] Create
    | 'CREATE' 'SILENT'? 'GRAPH' iri -> createOperation($2, $4)
    // [38] InsertData
    | 'INSERTDATA'  QuadPattern -> insertDataOperation($2)
    // [39] DeleteData
    | 'DELETEDATA'  QuadPattern -> deleteDataOperation($2)
    // [40] DeleteWhere
    | 'DELETEWHERE' QuadPattern -> deleteWhereOperation($2)
    // [41] Modify
    | WithClause? InsertDeleteClause UsingClause* 'WHERE' GroupGraphPattern -> modifyOperation($1, $2, $3, $5)
    ;

IntoGraphClause
    : 'INTO' GraphRef -> $2
    ;

InsertDeleteClause
    // [42] DeleteClause
    : 'DELETE' QuadPattern InsertClause? -> deleteInsertParts($2, $3)
    | InsertClause -> insertOnlyParts($1)
    ;

// [43]
InsertClause
    : 'INSERT' QuadPattern -> $2
    ;

// [44]
UsingClause
    : 'USING' 'NAMED'? iri -> datasetEntry($2, $3)
    ;

WithClause
    : 'WITH' iri -> withClause($2)
    ;

// [45]
GraphOrDefault
    : 'DEFAULT' -> graphOrDefaultDefault()
    | 'GRAPH'? iri -> graphOrDefaultNamed($2)
    ;

// [46]
GraphRef
    : 'GRAPH' iri -> $2
    ;

// [47]
GraphRefAll
    : GraphRef -> graphReferenceNamed($1)
    | ( 'DEFAULT' | 'NAMED' | 'ALL' ) -> graphReferenceKeyword($1)
    ;

// [48]
QuadPattern
    : '{' Quads '}' -> $2
    ;

// [50]
Quads
    : TriplesTemplate? QuadsNotTriples* -> quadsOf($1, $2)
    ;

// [51]
QuadsNotTriples
    : 'GRAPH' VarOrIri '{' TriplesTemplate? '}' '.'? TriplesTemplate? -> quadsGraphBlock($2, $4, $7)
    ;

// [52]
TriplesTemplate
    : (TriplesSameSubject '.')* TriplesSameSubject '.'? -> basicGraphPattern($1, $2)
    ;

// [53]
GroupGraphPattern
    : '{' SubSelect '}' -> subSelectGroup($2)
    | '{' GroupGraphPatternSub '}' -> groupGraphPattern($2)
    ;

// [54]
GroupGraphPatternSub
    : TriplesBlock? GroupGraphPatternSubTail* -> groupGraphPatternSub($1, $2)
    ;

GroupGraphPatternSubTail
    : GraphPatternNotTriples '.'? TriplesBlock? -> patternWithTriples($1, $3)
    ;

// [55]
TriplesBlock
    : (TriplesSameSubjectPath '.')* TriplesSameSubjectPath '.'? -> basicGraphPattern($1, $2)
    ;

// [56]
GraphPatternNotTriples
    : GroupOrUnionGraphPattern
    // [57] OptionalGraphPattern
    | 'OPTIONAL' GroupGraphPattern -> optionalPattern($2)
    // [66] MinusGraphPattern
    | 'MINUS' GroupGraphPattern -> minusPattern($2)
    // [58] GraphGraphPattern
    | 'GRAPH' VarOrIri GroupGraphPattern -> graphPattern($2, $3)
    // [59] ServiceGraphPattern
    | 'SERVICE' 'SILENT'? VarOrIri GroupGraphPattern -> servicePattern($2, $3, $4)
    // [68] Filter
    | 'FILTER' Constraint -> filterPattern($2)
    // [60] Bind
    | 'BIND' '(' Expression 'AS' Var ')' -> bindPattern($3, $5)
    | ValuesClause
    ;

// [61]
InlineData
    : 'VALUES' DataBlock -> nestedInlineData($2)
    ;

// [62]
DataBlock
    : InlineDataOneVar
    | InlineDataFull
    ;

// [63]
InlineDataOneVar
    : VAR '{' DataBlockValue* '}' -> valuesForVariable($1, $3)
    ;

// [64]
InlineDataFull
    : NIL '{' NIL* '}' -> emptyValuesRows($3)
    | '(' VAR+ ')' '{' DataBlockValueList* '}' -> valuesForVariables($2, $5)
    ;

// [65]
DataBlockValue
    : iri
    | Literal
    // @see https://w3c.github.io/rdf-star/cg-spec/editors_draft.html#sparql-star-grammar
    | QuotedTriple -> sparqlStarTerm($1)
    // [69] DataBlockValue — triple terms are data in VALUES blocks
    | TripleTerm
    | 'UNDEF' -> undefined
    ;

// [67]
GroupOrUnionGraphPattern
    : ( GroupGraphPattern 'UNION' )* GroupGraphPattern -> unionOrGroup($1, $2)
    ;

// [69]
Constraint
    : BrackettedExpression
    | BuiltInCall
    | FunctionCall
    ;

// [70]
FunctionCall
    : iri ArgList -> functionCall($1, $2)
    ;

// [71]
ArgList
    : NIL -> emptyArgList()
    | '(' 'DISTINCT'? ( Expression ',' )* Expression ')' -> argList($2, $3, $4)
    ;

// [72]
ExpressionList
    : NIL -> []
    | '(' ( Expression ',' )* Expression ')' -> expressionList($2, $3)
    ;

// [73]
ConstructTemplate
    : '{' ConstructTriples? '}' -> $2
    ;

// [74]
ConstructTriples
    : (TriplesSameSubject '.')* TriplesSameSubject '.'? -> flattenTripleLists($1, $2)
    ;

// [75]
TriplesSameSubject
    : VarOrTermOrQuotedTP PropertyListNotEmpty -> subjectTriples($1, $2)
    | TriplesNode PropertyList -> nodeSubjectTriples($1, $2) /* the subject is a blank node, possibly with more triples */
    // [58] ReifiedTripleBlock — a quoted triple (with optional reifier) as the
    // subject; with an empty property list it is a standalone reified-triple
    // pattern matching any reifier of the quoted triple.
    | QuotedTP PropertyList -> quotedSubjectTriples($1, $2)
    ;

// [76]
PropertyList
    : PropertyListNotEmpty?
    ;

// [77]
PropertyListNotEmpty
    : VerbObjectList ( SemiOptionalVerbObjectList )* -> propertyListTriples($1, $2)
    ;

SemiOptionalVerbObjectList
    : ';' VerbObjectList? -> optionalTriples($2)
    ;
VerbObjectList
    : Verb ObjectList -> objectListToTriples($1, $2)
    ;

// [78]
Verb
    : VarOrIri
    | 'a' -> rdfTypeTerm()
    ;

// [79]
ObjectList
    : (Object ',')* Object -> appendObject($1, $2)
    ;

// [80] Object ::= GraphNode Annotation — SPARQL 1.2 [86]
Object
    : GraphNode Annotation? -> annotatedObject($1, $2)
    ;

// [81]
TriplesSameSubjectPath
    : VarOrTermOrQuotedTP PropertyListPathNotEmpty -> subjectTriples($1, $2)
    | TriplesNodePath PropertyListPathNotEmpty? -> pathNodeSubjectTriples($1, $2)
    // [59] ReifiedTripleBlockPath — a quoted triple (with optional reifier) as
    // the subject; with an empty property list it is a standalone reified-triple
    // pattern matching any reifier of the quoted triple.
    | QuotedTP PropertyListPathNotEmpty? -> quotedSubjectTriples($1, $2)
    ;

// [82] Should be propertyListPath

// [83]
PropertyListPathNotEmpty
    : O PropertyListPathNotEmptyTail* -> pathPropertyListTriples($1, $2)
    ;

PropertyListPathNotEmptyTail
    : ';' -> []
    | ';' O -> pathVerbObjectTriples($2)
    ;

O : ( Path /* [84] VerbPath */ | Var /* [85] VerbSimple */ ) ObjectListPath -> pathVerbObjects($1, $2)
  ;

// [86]
ObjectListPath
    : (ObjectPath ',')* ObjectPath -> appendObject($1, $2)
    ;

// [87] ObjectPath ::= GraphNodePath AnnotationPath — SPARQL 1.2 [93]
ObjectPath
    : GraphNodePath AnnotationPath? -> annotatedObject($1, $2)
    ;

// [88] Path [89] PathAlternative
Path
    : ( PathSequence '|' )* PathSequence -> alternativePath($1, $2)
    ;

// [90]
PathSequence
    : ( PathEltOrInverse '/' )* PathEltOrInverse -> sequencePath($1, $2)
    ;

// [91]
PathElt
    : PathPrimary ('?'|'*'|'+' /* [93] PathMod */)? -> modifiedPath($1, $2)
    ;

// [92]
PathEltOrInverse
    : '^'? PathElt -> inversePath($1, $2)
    ;

// [94]
PathPrimary
    : IriOrA
    | '!' PathNegatedPropertySet -> negatedPath($1, $2)
    | '(' Path ')' -> $2
    ;

// [95]
PathNegatedPropertySet
    : PathOneInPropertySet
    | NIL -> []
    | '(' ( PathOneInPropertySet '|' )* PathOneInPropertySet? ')' -> negatedPropertySet($2, $3)
    ;

// [96]
PathOneInPropertySet
    : IriOrA
    | '^' IriOrA -> pathOf($1, [$2])
    ;

TriplesNode
    : '(' GraphNode+ ')' -> createList($2)
    | '[' PropertyListNotEmpty ']' -> createAnonymousObject($2)
    ;
TriplesNodePath
    : '(' GraphNodePath+ ')' -> createList($2)
    | '[' PropertyListPathNotEmpty ']' -> createAnonymousObject($2)
    ;

// [104]
GraphNode
    : VarOrTermOrQuotedTPExpr /* for consistency with TriplesNode */
    | TriplesNode
    ;

// [105]
GraphNodePath
    : VarOrTermOrQuotedTPExpr /* for consistency with TriplesNodePath */
    | TriplesNodePath
    ;

VarOrTermOrQuotedTPExpr
  : VarOrTermOrQuotedTP -> plainNode($1)
  | QuotedTP -> plainNode($1)
  ;

// [106]
VarOrTerm
    : Var
    // Was previously term
    | GraphTerm
    ;

// [107]
VarOrIri
    : Var
    | iri
    ;

// [108]
Var
    : VAR -> variableOf($1)
    ;

// [109]
GraphTerm
    : iri
    | Literal
    | BlankNode
    | NIL -> rdfNilTerm()
    // [119] TripleTerm — a data triple term `<<( s p o )>>`, allowed in any
    // term position (patterns, expressions, VALUES).
    | TripleTerm
    ;

// [110]
Expression
    : ConditionalOrExpression
    ;

// [111]
ConditionalOrExpression
    : ConditionalAndExpression ConditionalOrExpressionTail* -> createOperationTree($1, $2)
    ;

ConditionalOrExpressionTail
    : '||' ConditionalAndExpression -> operatorTail($1, $2)
    ;

// [112]
ConditionalAndExpression
    : RelationalExpression /* [113] ValueLogical */ ConditionalAndExpressionTail* -> createOperationTree($1, $2)
    ;

ConditionalAndExpressionTail
    : '&&' RelationalExpression /* [113] ValueLogical */ -> operatorTail($1, $2)
    ;

// [114]
RelationalExpression
    : NumericExpression
    | NumericExpression ( '=' | '!=' | '<' | '>' | '<=' | '>=' ) NumericExpression /* [116] AdditiveExpression */ -> binaryOperation($2, $1, $3)
    | NumericExpression 'NOT'? 'IN' ExpressionList -> membershipOperation($1, $2, $4)
    ;

// [115]
NumericExpression
    : MultiplicativeExpression AdditiveExpressionTail* -> createOperationTree($1, $2)
    ;
AdditiveExpressionTail
    : ( '+' | '-' ) MultiplicativeExpression -> operatorTail($1, $2)
    | NumericLiteralPositive MultiplicativeExpressionTail* -> signedTail('+', $1, $2)
    | NumericLiteralNegative MultiplicativeExpressionTail* -> negatedLiteralTail($1, $2)
    ;

// [117]
MultiplicativeExpression
    : UnaryExpression MultiplicativeExpressionTail* -> createOperationTree($1, $2)
    ;
MultiplicativeExpressionTail
    : ( '*' | '/' ) UnaryExpression -> operatorTail($1, $2)
    ;

// [135] — SPARQL 1.2 makes '!' recursive so `!!x` (double negation) parses;
// '+'/'-' remain single-shot (the pre-existing sparqljs 1.1 behavior).
UnaryExpression
    : '!' UnaryExpression -> unaryOperation('!', $2)
    | '+' PrimaryExpression -> unaryOperation('UPLUS', $2)
    | '-'  PrimaryExpression -> unaryOperation('UMINUS', $2)
    | PrimaryExpression -> $1
    ;

// [119]
PrimaryExpression
    : BrackettedExpression
    | BuiltInCall
    | iri
    | FunctionCall
    | Literal
    | Var
    | ExprQuotedTP
    // ExprTripleTerm — triple terms are terms in expressions (BIND, IN, ...)
    | TripleTerm
    ;

// [120]
BrackettedExpression
    : '(' Expression ')' -> $2
    ;

// [121]
BuiltInCall
    : Aggregate
    | FUNC_ARITY0 NIL -> operation(lowercase($1), [])
    | FUNC_ARITY1 '(' Expression ')' -> operation(lowercase($1), [$3])
    | FUNC_ARITY1_SPARQL_STAR '(' Expression ')' -> starOperation($1, [$3])
    | FUNC_ARITY2 '(' Expression ',' Expression ')' -> operation(lowercase($1), [$3, $5])
    // hasLang is variadic (1-3 args) as a documented superset extension: the
    // published SPARQL 1.2 grammar defines only the unary form, so it lexes as
    // its own token instead of a fixed-arity FUNC_ARITY* group.
    | HASLANG '(' Expression ')' -> operation(lowercase($1), [$3])
    | HASLANG '(' Expression ',' Expression ')' -> operation(lowercase($1), [$3, $5])
    | HASLANG '(' Expression ',' Expression ',' Expression ')' -> operation(lowercase($1), [$3, $5, $7])
    | FUNC_ARITY3 '(' Expression ',' Expression ',' Expression ')' -> operation(lowercase($1), [$3, $5, $7])
    | FUNC_ARITY3_SPARQL_STAR '(' Expression ',' Expression ',' Expression ')' -> starOperation($1, [$3, $5, $7])
    // [122], [123], [124]
    | ( 'CONCAT' | 'COALESCE' | 'SUBSTR' | 'REGEX' | 'REPLACE' ) ExpressionList -> operation(lowercase($1), $2)
    | 'BOUND' '(' VAR ')' -> boundOperation($3)
    | 'BNODE' NIL -> operation($1, [])
    | 'BNODE' '(' Expression ')' -> operation($1, [$3])
    // [125], [126]
    | 'NOT'? 'EXISTS' GroupGraphPattern -> existsOperation($1, $3)
    ;

// [127]
Aggregate
    : 'COUNT' '(' 'DISTINCT'? ( '*' | Expression ) ')' -> aggregate($1, $3, $4)
    | FUNC_AGGREGATE '(' 'DISTINCT'? Expression ')' -> aggregate($1, $3, $4)
    | 'GROUP_CONCAT' '(' 'DISTINCT'? Expression GroupConcatSeparator? ')'  -> aggregate($1, $3, $4, $5, true)
    ;

GroupConcatSeparator
    : ';' 'SEPARATOR' '=' String -> $4
    ;

// Summary of [129], [130] & [134]
Literal
    // [129] RDFLiteral
    : String -> typedLiteral($1)
    | String LANGTAG  -> languageLiteral($1, $2)
    | String '^^' iri -> typedLiteralOf($1, $3)
    // [131] NumericLiteralUnsigned
    | INTEGER -> integerLiteral($1)
    | DECIMAL -> decimalLiteral($1)
    | DOUBLE  -> doubleLiteral($1)
    | NumericLiteralPositive
    | NumericLiteralNegative
    // [134] BooleanLiteral
    | BOOLEAN -> booleanLiteral($1)
    ;

// [132]
NumericLiteralPositive
    : INTEGER_POSITIVE -> signedIntegerLiteral($1)
    | DECIMAL_POSITIVE -> signedDecimalLiteral($1)
    | DOUBLE_POSITIVE  -> signedDoubleLiteral($1)
    ;

// [133]
NumericLiteralNegative
    : INTEGER_NEGATIVE -> integerLiteral($1)
    | DECIMAL_NEGATIVE -> decimalLiteral($1)
    | DOUBLE_NEGATIVE  -> doubleLiteral($1)
    ;

// [135]
String
    : STRING_LITERAL1 -> unescapeString($1, 1)
    | STRING_LITERAL2 -> unescapeString($1, 1)
    | STRING_LITERAL_LONG1 -> unescapeString($1, 3)
    | STRING_LITERAL_LONG2 -> unescapeString($1, 3)
    ;

// [136]
iri
    : IRIREF -> iriFromToken($1)
    | PrefixedName
    ;

// [137]
PrefixedName
    : PNAME_LN -> prefixedNameLocal($1)
    | PNAME_NS -> prefixedNameNamespace($1)
    ;

// [138]
BlankNode
    : BLANK_NODE_LABEL -> labelledBlank($1)
    | ANON -> blank()
    ;

//
// Note [139] - [173] are grammar terms that are written above
//

// [174] / [116]
QuotedTP
    : '<<' qtSubjectOrObject Verb qtSubjectOrObject '>>' -> quotedTriple($2, $3, $4)
    // [116] ReifiedTriple with a reifier binding `<< s p o ~ r >>`
    | '<<' qtSubjectOrObject Verb qtSubjectOrObject '~' reifier '>>' -> quotedTripleWithReifier($2, $3, $4, $6)
    ;

// [175]
QuotedTriple
    : '<<'  DataValueTerm IriOrA DataValueTerm '>>' -> quotedTriple($2, $3, $4)
    ;

// [176]
qtSubjectOrObject
    : Var
    | iri
    | BlankNode
    | Literal
    | QuotedTP
    | TripleTerm
    ;


// [177]
DataValueTerm
    : iri
    | Literal
    | QuotedTP
    | TripleTerm
    ;

// [119] TripleTerm — the SPARQL 1.2 data triple-term form `<<( s p o )>>`.
// Nested triple terms are allowed; the result is an RDF/JS Quad carrying a
// `tripleTerm` marker so the evaluator treats it as data (never a reifier).
TripleTerm
    : '<<(' qtSubjectOrObject Verb qtSubjectOrObject ')>>' -> tripleTerm($2, $3, $4)
    ;

// [70] Reifier — the `~` clause binding the reifier of a quoted triple.
reifier
    : VAR -> variableOf($1)
    | iri -> $1
    | BlankNode -> $1
    ;

// [178]
VarOrTermOrQuotedTP
    : Var
    | GraphTerm
    ;

// [179]
AnnotationPattern
    : '{|' PropertyListNotEmpty '|}' -> annotationBlock($2)
    ;

// [180]
AnnotationPatternPath
    : '{|' PropertyListPathNotEmpty '|}' -> annotationBlock($2)
    ;

// [111] Annotation ::= ( Reifier | AnnotationBlock )* — SPARQL 1.2. The
// parts of an object-level annotation: a `~` reifier clause and/or one or
// more `{| ... |}` annotation blocks, in any order.
Annotation
    : AnnotationPart -> [$1]
    | Annotation AnnotationPart -> appendAnnotation($1, $2)
    ;

AnnotationPart
    : Reifier
    | AnnotationPattern
    ;

// [109] AnnotationPath ::= ( Reifier | AnnotationBlockPath )*
AnnotationPath
    : AnnotationPartPath -> [$1]
    | AnnotationPath AnnotationPartPath -> appendAnnotation($1, $2)
    ;

AnnotationPartPath
    : Reifier
    | AnnotationPatternPath
    ;

// [70] Reifier ::= '~' VarOrReifierId? — SPARQL 1.2. A named reifier is
// an IRI, blank node, or variable; a bare `~` mints a fresh reifier at
// evaluation time. The value travels as `{ reifier: term|null }` so
// applyAnnotations can bind annotation triples to the named reifier.
Reifier
    : '~' reifier? -> reifierClause($2)
    ;


// [181]
ExprQuotedTP
    : '<<'  ExprVarOrTerm Verb ExprVarOrTerm '>>' -> quotedTriple($2, $3, $4)
    ;

// [182]
ExprVarOrTerm
  : VarOrIri
  | ExprQuotedTP
  | Literal
  | TripleTerm
  ;

// Utilities
IriOrA
    : iri -> $1
    | 'a' -> rdfTypeTerm()
    ;
